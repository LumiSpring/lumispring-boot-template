{
  "groups": [
    {
      "name": "security",
      "type": "com.lumispring.framework.security.config.SecurityProperties",
      "sourceType": "com.lumispring.framework.security.config.SecurityProperties"
    }
  ],
  "properties": [
    {
      "name": "security.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用安全模块（登录、权限校验等）",
      "defaultValue": true,
      "sourceType": "com.lumispring.framework.security.config.SecurityProperties"
    },
    {
      "name": "security.timeout",
      "type": "java.lang.Long",
      "description": "登录 Token 有效期（秒）",
      "defaultValue": 604800,
      "sourceType": "com.lumispring.framework.security.config.SecurityProperties"
    },
    {
      "name": "security.api-key",
      "type": "java.lang.String",
      "description": "API 密钥，配合 security.api-header 使用时可跳过用户验证",
      "sourceType": "com.lumispring.framework.security.config.SecurityProperties"
    },
    {
      "name": "security.api-header",
      "type": "java.lang.String",
      "description": "携带 API 密钥的请求头名称",
      "defaultValue": "security-key",
      "sourceType": "com.lumispring.framework.security.config.SecurityProperties"
    }
  ]
}
